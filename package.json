{
  "name": "dsh-chibi-pet",
  "version": "1.0.0",
  "type": "module",
  "description": "A floating chibi pet for the DeepSeek Harness Web GUI: it follows one session, reacts to what that session is doing, and takes work you type into it.",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "client.js",
    "index.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "docs/*.png",
    "src",
    "tools",
    "README.md",
    "LICENSE",
    "ATTRIBUTION.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "license": "MIT",
  "author": "Cheva1234",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cheva1234/dsh-chibi-pet.git"
  },
  "homepage": "https://github.com/Cheva1234/dsh-chibi-pet#readme",
  "bugs": {
    "url": "https://github.com/Cheva1234/dsh-chibi-pet/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "pet",
    "sprite",
    "companion"
  ],
  "engines": {
    "node": ">=20"
  }
}
